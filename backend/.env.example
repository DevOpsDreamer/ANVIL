# ─────────────────────────────────────────────
# ANVIL Backend — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# ── LLM (required) ───────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# ── GitHub OAuth App (required for web UI) ───
# Create at: https://github.com/settings/developers → New OAuth App
# Homepage URL:       http://localhost:5173
# Callback URL:       http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Session security ──────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-32-byte-secret

# ── Infrastructure (localhost defaults — no Docker needed) ───────────────────
REDIS_URL=redis://localhost:6379/0
SQLITE_DB_PATH=master_state.db

# ── Sandbox ───────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_RETRIES=3

# ── Omium / OpenTelemetry ─────────────────────
OMIUM_API_KEY=omium_poJ52g3sSBV6Cijv9kAi-HmAsqZiPptZNaSpLfofb-E
OMIUM_ENDPOINT=ingest.monium.yandex.cloud:443
SERVICE_NAME=red-team-engine
